---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date: string;
  readTime?: string;
}

const { title, description, date, readTime } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Shahzaib`} description={description}>
  <article class="pt-12 fade-in">
    <header class="mb-10">
      <a
        href="/articles"
        class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)] transition-colors mb-6 inline-block"
      >
        ← articles
      </a>
      <h1 class="text-3xl font-serif leading-tight mb-4" style="font-family: var(--font-serif)">
        {title}
      </h1>
      <div class="flex items-center gap-3 text-sm text-[var(--color-muted)]">
        <time datetime={date}>{formattedDate}</time>
        {readTime && (
          <>
            <span>·</span>
            <span>{readTime}</span>
          </>
        )}
      </div>
    </header>

    <div class="prose-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-ink);
  }
  .prose-content :global(p) {
    line-height: 1.75;
    margin-bottom: 1.25rem;
    color: #374151;
  }
  .prose-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--color-ink);
  }
  .prose-content :global(code) {
    background: var(--color-border);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.875em;
  }
  .prose-content :global(pre) {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .prose-content :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-content :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 1.5rem 0;
  }
</style>
