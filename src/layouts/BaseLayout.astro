---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  fullHeight?: boolean;
}

const {
  title = 'Shahzaib Khan - Full-Stack AI Engineer',
  description = 'Full-Stack AI Engineer shipping production AI systems end-to-end. Agents, RAG pipelines, voice AI, and more.',
  ogImage = '/og-image.png',
  fullHeight = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Dark mode: apply before paint to prevent flash -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Calendly -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
  </head>
  <body class="flex flex-col bg-[var(--color-cream)] text-[var(--color-ink)]">
    <header class="flex-shrink-0 sticky top-0 z-50 bg-[var(--color-cream)]/90 backdrop-blur-sm border-b border-[var(--color-border)]">
      <Nav />
    </header>
    <main class="flex-1 w-full">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <slot />
      </div>
    </main>
    <div class="flex-shrink-0">
      <Footer />
    </div>
  </body>
</html>
