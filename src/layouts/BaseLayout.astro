---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { baseGraph, person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Extra JSON-LD nodes for this page, merged into the site graph. */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title = 'Shahzaib Khan · AI Engineer',
  description = person.summary,
  ogImage = '/og-image.png',
  jsonLd = [],
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph(), ...jsonLd] };

// Pages build as about.html etc.; canonical URLs drop the extension and trailing slash.
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonicalURL = new URL(cleanPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Shahzaib Khan" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shahzaib Khan, AI engineer" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="author" content="Shahzaib Khan" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="alternate" type="application/rss+xml" title="Shahzaib Khan · Writing" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="me" href="https://www.linkedin.com/in/shahzaib17" />
    <link rel="me" href="https://github.com/Shahzaib0217" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Dark mode: apply before paint to prevent flash -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Calendly -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
  </head>
  <body class="flex flex-col min-h-dvh bg-[var(--color-paper)] text-[var(--color-ink)]">
    <header class="sticky top-0 z-50 bg-[var(--color-paper)]/85 backdrop-blur-md border-b border-[var(--color-rule)]">
      <Nav />
    </header>
    <main class="flex-1 w-full">
      <div class="max-w-6xl mx-auto px-4 sm:px-8">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
