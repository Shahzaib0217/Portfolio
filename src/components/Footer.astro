  <div class="max-w-6xl mx-auto w-full px-4 sm:px-8 py-5 flex flex-wrap items-center justify-between gap-4">
    <a href="mailto:hello@shahzaib.ai" class="text-sm font-medium hover:text-[var(--color-signal)] transition-colors">
      hello@shahzaib.ai
    </a>

    <div class="flex items-center gap-5">
      <a href="https://linkedin.com/in/shahzaib17" target="_blank" rel="noopener noreferrer" class="label hover:text-[var(--color-ink)] transition-colors">LinkedIn</a>
      <a href="https://github.com/Shahzaib0217" target="_blank" rel="noopener noreferrer" class="label hover:text-[var(--color-ink)] transition-colors">GitHub</a>
