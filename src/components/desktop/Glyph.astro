---
// Line icons shared by desktop icons, the taskbar and the phone dock.
// Stroke colours come from the parent (.icon-tile / .task CSS).
export type GlyphName = 'doc' | 'chat' | 'meet' | 'bell' | 'folder' | 'pen' | 'pdf' | 'mail' | 'call' | 'linkedin' | 'github' | 'user' | 'school';
interface Props { name: GlyphName }
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true">
  {name === 'doc' && <><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 15h5M10 18h3"/></>}
  {name === 'chat' && <><path d="M4 5.5A1.5 1.5 0 015.5 4h13A1.5 1.5 0 0120 5.5v9a1.5 1.5 0 01-1.5 1.5H10l-4.5 4v-4h0A1.5 1.5 0 014 14.5z"/><path d="M8.5 10h.01M12 10h.01M15.5 10h.01" class="accent"/></>}
  {name === 'meet' && <><rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10l5-3v10l-5-3"/></>}
  {name === 'bell' && <><path d="M6 17a6 6 0 0112 0M12 8V6M10 6h4"/><path d="M3 20h18M4 17h16"/></>}
  {name === 'folder' && <path d="M3 6h6l2 2h10v11H3z"/>}
  {name === 'pen' && <><path d="M4 20l4-1L19 8l-3-3L5 16z"/><path d="M14 7l3 3"/></>}
  {name === 'pdf' && <><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><text x="8.3" y="17" font-size="4.6" font-family="IBM Plex Mono, monospace" font-weight="600" stroke="none" fill="currentColor">PDF</text></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></>}
  {name === 'call' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M8 14h3"/></>}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v6M8 7.5v.01M12 17v-6M12 13.5a2.5 2.5 0 015 0V17"/></>}
  {name === 'github' && <path d="M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 00-1.3-3.2 4.3 4.3 0 00-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 00-6 0C6.8 2.8 5.8 3.1 5.8 3.1a4.3 4.3 0 00-.1 3.2A4.6 4.6 0 004.4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>}
  {name === 'school' && <><path d="M2 9.5L12 5l10 4.5L12 14z"/><path d="M6 11.5v4.5c3.5 2.5 8.5 2.5 12 0v-4.5M22 9.5V15"/></>}
  {name === 'user' && <><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></>}
</svg>
