---
// A recording strip. The playhead "records" the AI clone's voice activity:
// idle it lays down quiet bars, and while the clone streams a reply every
// token pushes the level up, so the strip keeps a trace of the conversation.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`waveform relative w-full ${className}`} aria-hidden="true">
  <canvas class="block w-full h-full"></canvas>
</div>

<script>
  document.querySelectorAll<HTMLDivElement>('.waveform').forEach(mount);

  function mount(root: HTMLDivElement) {
    const canvas = root.querySelector('canvas');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const STEP = 5;          // px between bar starts
    const BAR = 2;           // bar width
    const LOOP_SECONDS = 18; // one pass of the playhead
    const IDLE = 0.16;
    const SPEAKING = 0.5;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let amps = new Float32Array(0);
    let head = 0;            // fractional bar index
    let level = IDLE;
    let target = IDLE;
    let colors = { ink: '#121417', ghost: '#D9DBD5', signal: '#3B2BFF' };
    let visible = true;
    let last = performance.now();
    let running = false;

    function readColors() {
      const s = getComputedStyle(document.documentElement);
      colors = {
        ink: s.getPropertyValue('--color-ink').trim() || colors.ink,
        ghost: s.getPropertyValue('--color-rule').trim() || colors.ghost,
        signal: s.getPropertyValue('--color-signal').trim() || colors.signal,
      };
    }

    // Speech-like shape: syllables inside phrases, with random texture.
    function speechAmp(k: number, base: number) {
      const phrase = Math.abs(Math.sin(k * 0.035 + 1.3));
      const syllable = Math.abs(Math.sin(k * 0.23));
      return base * (0.25 + 0.75 * phrase * syllable) * (0.55 + 0.45 * Math.random());
    }

    function resize() {
      const rect = root.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const n = Math.max(1, Math.floor(width / STEP));
      const next = new Float32Array(n);
      for (let k = 0; k < n; k++) {
        next[k] = k < amps.length ? amps[k] : speechAmp(k, 0.75);
      }
      amps = next;
      if (head === 0 || head >= n) head = n * 0.42;
      draw();
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);
      const mid = height / 2;
      const headIdx = Math.floor(head);

      for (let k = 0; k < amps.length; k++) {
        const h = Math.max(2, amps[k] * height * 0.92);
        ctx.fillStyle = k <= headIdx ? colors.ink : colors.ghost;
        ctx.fillRect(k * STEP, mid - h / 2, BAR, h);
      }

      // Playhead
      const x = headIdx * STEP + BAR + 1;
      ctx.fillStyle = colors.signal;
      ctx.fillRect(x, 0, 1.5, height);
      ctx.beginPath();
      ctx.arc(x + 0.75, 3, 3, 0, Math.PI * 2);
      ctx.fill();
    }

    function tick(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;

      // Ease the level toward its target; tokens add short spikes on top.
      level += (target - level) * Math.min(1, dt * 3);

      const n = amps.length;
      const prev = Math.floor(head);
      head += (n / LOOP_SECONDS) * dt;
      if (head >= n) head -= n;
      const curr = Math.floor(head);

      // Record every bar the playhead crossed this frame.
      for (let k = prev; k !== curr; ) {
        k = (k + 1) % n;
        amps[k] = speechAmp(k, level);
      }

      draw();
      if (visible) requestAnimationFrame(tick);
      else running = false;
    }

    function start() {
      if (running) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(tick);
    }

    readColors();
    resize();
    new ResizeObserver(resize).observe(root);
    new MutationObserver(() => { readColors(); draw(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    if (!reduceMotion) {
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) start();
      }).observe(root);
      start();

      window.addEventListener('clone:speaking', (e) => {
        target = (e as CustomEvent<boolean>).detail ? SPEAKING : IDLE;
      });
      window.addEventListener('clone:token', () => {
        level = Math.min(1, level + 0.12);
      });
    }
  }
</script>
