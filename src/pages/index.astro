---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chat from '../components/Chat';
import Waveform from '../components/Waveform.astro';
import { roles, earlier } from '../data/work';
import { profilePage } from '../data/site';

const bridge = roles.find(r => r.company === 'Bridge')!;

const pipeline = [
  { step: 'Meet', detail: 'Bridge calls, live or captured' },
  { step: 'Transcribe', detail: 'AssemblyAI · Deepgram' },
  { step: 'Reason', detail: 'LangChain agent workflows' },
  { step: 'Act', detail: 'MCP → ClickUp · Slack · Drive · Notion' },
];

const bridgeProduct = [
  'Lead architecture across the agentic AI pipeline, backend services and integrations.',
  'Built the agent workflows that turn a meeting into summaries, tasks and follow-ups.',
  'Built speech-to-text on AssemblyAI and Deepgram.',
  'Cut database query latency from 60s to under 2s.',
];

const bridgeGrowth = [
  'A content engine that researches, writes and publishes SEO articles end to end.',
  'Programmatic SEO, AEO and GEO pipelines built to get Bridge ranked on Google and cited by ChatGPT, Perplexity and AI Overviews.',
  'Structured data, llms.txt and AI-crawler optimization.',
];

const channels = ['Voice', 'WhatsApp', 'Email', 'Web chat'];
const hometels = ['Chiswick, London', 'Belfast', 'Southampton'];

const zehnProgrammes = [
  { name: 'Zehn School', meta: 'Grades 5–7 · 3 years', body: 'Computing, AI and entrepreneurship, taught by the school’s own teachers. Scratch in year one, Python apps in year two, an AI product they pitch in year three.' },
  { name: 'Zehn College', meta: 'FSc · ICS · FA · 8 Saturdays', body: 'On-campus sessions on tech careers, AI tools and paid online work, ending with a personal 90-day plan.' },
  { name: 'Zehn Online', meta: 'Ages 8–18', body: 'Live coding and AI classes with a real instructor, where parents learn alongside their kids.' },
];
---

<BaseLayout
  title="Shahzaib Khan · AI Engineer for AI Agents, Voice AI and MCP"
  ogType="profile"
  jsonLd={[profilePage('/', 'Shahzaib Khan · AI Engineer')]}
>
  <!-- Hero -->
  <section class="pt-12 pb-12 sm:pt-20 sm:pb-16">
    <p class="label flex items-center gap-2.5 fade-in">
      <span class="live-dot"></span>
      Open to new work <span aria-hidden="true">·</span> Founding Senior Engineer at <a href="https://meetonbridge.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] link">Bridge</a>
    </p>

    <h1 class="display mt-6 sm:mt-8 text-[clamp(2.5rem,7vw,6.5rem)] max-w-[19ch] fade-in fade-in-delay-1">
      I build AI that joins the meeting, answers the phone, and handles the follow&#8209;up.
    </h1>

    <div class="mt-8 sm:mt-12 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 fade-in fade-in-delay-2">
      <p class="text-[var(--color-muted)] text-base sm:text-lg leading-relaxed max-w-[46ch]">
        I'm <span class="text-[var(--color-ink)] font-medium">Shahzaib Khan</span>. I was Bridge's first engineer:
        MVP in two months, ~500 users today, now Founding Senior Engineer. I take AI products from the first
        commit to real users, working remotely from Pakistan with teams in the US and UK.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="#clone" class="text-sm px-5 py-3 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] font-medium hover:opacity-85 transition-opacity">
          Interview my AI clone ↓
        </a>
        <a href="/work" class="text-sm px-5 py-3 rounded-full border border-[var(--color-rule)] font-medium hover:border-[var(--color-ink)] transition-colors">
          See the work
        </a>
      </div>
    </div>
  </section>

  <!-- Clone: the waveform records its voice -->
  <section id="clone" class="scroll-mt-20 pb-20 sm:pb-28 fade-in fade-in-delay-3">
    <Waveform class="h-16 sm:h-24" />
    <div class="flex items-center justify-between mt-3 mb-8">
      <p class="label">Recording · my AI clone</p>
      <p class="label hidden sm:block">Every reply is drawn here as it streams</p>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
      <div class="lg:col-span-4">
        <h2 class="display text-4xl sm:text-5xl">Interview my AI clone</h2>
        <p class="mt-4 text-[var(--color-muted)] leading-relaxed max-w-[40ch]">
          It knows my work history and how I approach problems. Ask it the questions you'd ask in a first call.
          When you want the real me, <a href="/call" class="link text-[var(--color-ink)]" onclick="if(window.Calendly){Calendly.initPopupWidget({url:'https://calendly.com/shahzaib-khan0217/30min?hide_gdpr_banner=1'});return false;}">book 30 minutes</a>.
        </p>
      </div>
      <div class="lg:col-span-8 h-[32rem] sm:h-[34rem]">
        <Chat client:load />
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section aria-labelledby="work-heading" class="pb-8">
    <div class="flex items-end justify-between border-b border-[var(--color-ink)] pb-4">
      <h2 id="work-heading" class="display text-4xl sm:text-5xl">What I'm building now</h2>
      <a href="/work" class="label hover:text-[var(--color-ink)] transition-colors hidden sm:block">Full history →</a>
    </div>

    <!-- Bridge -->
    <article id="bridge" class="scroll-mt-20 grid lg:grid-cols-12 gap-10 lg:gap-12 py-14 sm:py-20 border-b border-[var(--color-rule)]">
      <div class="lg:col-span-5">
        <p class="label">Career highlight · {bridge.period} · {bridge.location}</p>
        <h3 class="display text-6xl sm:text-8xl mt-4">Bridge</h3>
        <p class="mt-2 text-[var(--color-muted)]">by Simplora</p>
        <p class="mt-5 text-lg leading-relaxed">
          Where teams and AI agents meet. Bridge is one workspace for meetings: calls, live notes,
          memory of people and companies, and agents that join the call and act on what was said.
        </p>
        <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
          I joined as the first engineer and built the MVP. Today I lead engineering across the product and growth.
        </p>

        <ol class="mt-8 border-l border-[var(--color-rule)] pl-5 space-y-4" aria-label="Roles at Bridge">
          {bridge.ladder!.map((step, i) => (
            <li class="relative">
              <span class={`absolute -left-[25px] top-1.5 w-2 h-2 rounded-full ${i === 0 ? 'bg-[var(--color-signal)]' : 'bg-[var(--color-rule)]'}`}></span>
              <p class="font-medium leading-tight">{step.role}</p>
              <p class="label mt-1">From {step.from}</p>
            </li>
          ))}
        </ol>

        <a href={bridge.url!} target="_blank" rel="noopener noreferrer" class="inline-block mt-8 text-sm link">meetonbridge.com ↗</a>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-10">
        <dl class="grid grid-cols-3 gap-px bg-[var(--color-rule)] border border-[var(--color-rule)] rounded-xl overflow-hidden">
          <div class="bg-[var(--color-paper)] p-4 sm:p-5">
            <dt class="label">MVP shipped</dt>
            <dd class="display text-3xl sm:text-5xl mt-2">2 mo</dd>
          </div>
          <div class="bg-[var(--color-paper)] p-4 sm:p-5">
            <dt class="label">Users</dt>
            <dd class="display text-3xl sm:text-5xl mt-2">~500</dd>
          </div>
          <div class="bg-[var(--color-paper)] p-4 sm:p-5">
            <dt class="label">DB query speed</dt>
            <dd class="display text-3xl sm:text-5xl mt-2">30×</dd>
            <dd class="text-xs text-[var(--color-muted)] mt-1">60s → under 2s</dd>
          </div>
        </dl>

        <div>
          <p class="label mb-3">How a meeting becomes work</p>
          <ol class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            {pipeline.map((p, i) => (
              <li class="relative rounded-xl border border-[var(--color-rule)] bg-[var(--color-panel)] p-3.5">
                <span class="font-mono text-[0.68rem] text-[var(--color-signal)]">{String(i + 1).padStart(2, '0')}</span>
                <p class="font-medium mt-1">{p.step}</p>
                <p class="text-xs text-[var(--color-muted)] mt-1 leading-snug">{p.detail}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="grid sm:grid-cols-2 gap-8">
          <div>
            <p class="label mb-3">Product</p>
            <ul class="space-y-2.5 text-[0.95rem] leading-relaxed">
              {bridgeProduct.map(item => <li class="pl-4 relative before:content-[''] before:absolute before:left-0 before:top-[0.7em] before:w-1.5 before:h-px before:bg-[var(--color-muted)]">{item}</li>)}
            </ul>
          </div>
          <div>
            <p class="label mb-3">Growth engineering</p>
            <ul class="space-y-2.5 text-[0.95rem] leading-relaxed">
              {bridgeGrowth.map(item => <li class="pl-4 relative before:content-[''] before:absolute before:left-0 before:top-[0.7em] before:w-1.5 before:h-px before:bg-[var(--color-muted)]">{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </article>

    <!-- DreamDesk × Second Nature -->
    <article id="dreamdesk" class="scroll-mt-20 grid lg:grid-cols-12 gap-10 lg:gap-12 py-14 sm:py-20 border-b border-[var(--color-rule)]">
      <div class="lg:col-span-5">
        <p class="label">In production · Jan 2026 – Present · Remote, UK</p>
        <h3 class="display text-5xl sm:text-7xl mt-4">DreamDesk AI</h3>
        <p class="mt-2 text-[var(--color-muted)]">AI Product Engineer &amp; Team Lead</p>
        <p class="mt-5 text-lg leading-relaxed">
          Hospitality AI from <a href="https://staysecondnature.com/" target="_blank" rel="noopener noreferrer" class="link">Second Nature</a>
          (formerly room2), the hometel group behind DreamDesk. Our agents look after guests across its hometels
          on the phone, WhatsApp, email and the web, with live reservation data from the hotel's systems.
        </p>
        <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
          I led a team of two, shipped the proof of concept in four weeks, and designed the product end to end:
          architecture, UX, the RAG pipeline, and Mews and Guestline PMS integrations.
        </p>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-8">
        <!-- Latency meter -->
        <div class="rounded-xl border border-[var(--color-rule)] bg-[var(--color-panel)] p-5 sm:p-7">
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <p class="label">Voice agent response time</p>
            <p class="label">Includes RAG + MCP calls</p>
          </div>
          <p class="display text-6xl sm:text-8xl mt-4">~1.7<span class="text-[0.5em] align-baseline ml-1">s</span></p>
          <div class="mt-6" aria-hidden="true">
            <div class="relative h-2 rounded-full bg-[var(--color-wash)] overflow-hidden">
              <div class="latency-fill absolute inset-y-0 left-0 rounded-full bg-[var(--color-signal)]" style="width: 56.7%"></div>
            </div>
            <div class="flex justify-between mt-2 font-mono text-[0.68rem] text-[var(--color-muted)]">
              <span>0s</span><span>1s</span><span>2s</span><span>3s</span>
            </div>
          </div>
          <p class="mt-4 text-sm text-[var(--color-muted)] leading-relaxed">
            End to end on a voice call, including the hotel knowledge-base lookup (RAG) and tool calls over MCP.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-8">
          <div>
            <p class="label mb-3">Channels</p>
            <ul class="space-y-2">
              {channels.map(c => (
                <li class="flex items-center gap-3"><span class="live-dot"></span>{c}</li>
              ))}
            </ul>
          </div>
          <div>
            <p class="label mb-3">Live at 3 hometels</p>
            <ul class="space-y-2">
              {hometels.map(h => <li>{h}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </article>

    <!-- Zehn -->
    <article id="zehn" class="scroll-mt-20 grid lg:grid-cols-12 gap-10 lg:gap-12 py-14 sm:py-20">
      <div class="lg:col-span-5">
        <p class="label">My own startup · Since Sep 2026</p>
        <h3 class="display text-5xl sm:text-7xl mt-4">Zehn</h3>
        <p class="mt-5 text-lg leading-relaxed">
          Zehn prepares schools and colleges in Pakistan for an AI-powered future. Kids learn to build
          software and use AI the way it's actually used at work today.
        </p>
        <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
          Zehn started because I was curious whether I could. It pulled me into the work that isn't code: pitching to schools, training teachers,
          and explaining AI so a ten-year-old can build with it. It's made me better at deciding what to build,
          not just how.
        </p>
        <a href="https://zehn.school/" target="_blank" rel="noopener noreferrer" class="inline-block mt-8 text-sm link">zehn.school ↗</a>
      </div>

      <div class="lg:col-span-7 grid gap-3">
        {zehnProgrammes.map(p => (
          <div class="rounded-xl border border-[var(--color-rule)] p-5 sm:p-6 grid sm:grid-cols-[11rem_1fr] gap-2 sm:gap-6">
            <div>
              <p class="font-medium">{p.name}</p>
              <p class="label mt-1 normal-case tracking-normal">{p.meta}</p>
            </div>
            <p class="text-[0.95rem] text-[var(--color-muted)] leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </article>
  </section>

  <!-- Earlier -->
  <section aria-labelledby="earlier-heading" class="py-14 sm:py-20">
    <div class="flex items-end justify-between border-b border-[var(--color-ink)] pb-4">
      <h2 id="earlier-heading" class="display text-4xl sm:text-5xl">Before that</h2>
      <a href="/work" class="label hover:text-[var(--color-ink)] transition-colors">Details →</a>
    </div>
    <ul>
      {earlier.map(job => (
        <li class="grid grid-cols-1 sm:grid-cols-12 gap-1 sm:gap-6 py-5 border-b border-[var(--color-rule)]">
          <p class="sm:col-span-3 label pt-1">{job.period}</p>
          <div class="sm:col-span-4">
            <p class="font-medium">{job.company}</p>
            <p class="text-sm text-[var(--color-muted)]">{job.role}</p>
          </div>
          <p class="sm:col-span-5 text-[0.95rem] text-[var(--color-muted)] leading-relaxed">{job.summary}</p>
        </li>
      ))}
      <li class="grid grid-cols-1 sm:grid-cols-12 gap-1 sm:gap-6 py-5 border-b border-[var(--color-rule)]">
        <p class="sm:col-span-3 label pt-1">2024 · Research</p>
        <div class="sm:col-span-4">
          <p class="font-medium">FAST NUCES</p>
          <p class="text-sm text-[var(--color-muted)]">BS Computer Science</p>
        </div>
        <p class="sm:col-span-5 text-[0.95rem] text-[var(--color-muted)] leading-relaxed">
          First-author paper on LLM-generated test properties for Solidity smart contracts, with researchers at DFKI Bremen and UAEU. Under review at STVR.
        </p>
      </li>
    </ul>
  </section>

  <!-- CTA -->
  <section class="pt-6 pb-24 sm:pb-32">
    <p class="label flex items-center gap-2.5"><span class="live-dot"></span> Open to new work · Remote from Pakistan, overlapping US and UK hours</p>
    <h2 class="display mt-5 text-[clamp(2.4rem,7vw,5.5rem)] max-w-[16ch]">Building something with AI? Tell me about it.</h2>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/call"
        onclick="if(window.Calendly){Calendly.initPopupWidget({url:'https://calendly.com/shahzaib-khan0217/30min?hide_gdpr_banner=1'});return false;}"
        class="text-sm px-5 py-3 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] font-medium hover:opacity-85 transition-opacity"
      >
        Book a 30-minute call
      </a>
      <a href="mailto:hello@shahzaib.ai" class="text-sm px-5 py-3 rounded-full border border-[var(--color-rule)] font-medium hover:border-[var(--color-ink)] transition-colors">
        hello@shahzaib.ai
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .latency-fill {
    transform-origin: left;
    animation: grow 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-timeline: view();
    animation-range: entry 10% cover 40%;
  }
  @keyframes grow {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .latency-fill { animation: none; }
  }
</style>
