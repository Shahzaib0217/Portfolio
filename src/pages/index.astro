---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chat from '../components/Chat';
---

<BaseLayout>
  <div class="h-full flex flex-col overflow-hidden">

    <!-- Hero -->
    <section class="pt-6 pb-5 sm:pt-10 sm:pb-8 fade-in flex-shrink-0">
      <div class="flex items-start gap-5">
        <img
          src="/shahzaib.png"
          alt="Shahzaib"
          width="80"
          height="80"
          class="rounded-full object-cover flex-shrink-0 border border-[var(--color-border)]"
          onerror="this.style.display='none'"
        />
        <div>
          <h1
            class="text-2xl sm:text-3xl mb-2 leading-tight"
            style="font-family: var(--font-serif)"
          >
            <span id="greeting" class="inline-block">Salam</span>, I'm Shahzaib Khan
          </h1>
          <p class="text-[var(--color-muted)] text-base leading-relaxed max-w-lg">
            I ship production AI systems end-to-end. Feel free to interview my digital clone :)
          </p>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="border-t border-[var(--color-border)] fade-in fade-in-delay-2 flex-shrink-0"></div>

    <!-- AI Chat — fills remaining height, messages scroll inside -->
    <section class="pt-6 pb-6 fade-in fade-in-delay-3 flex-grow overflow-hidden min-h-0">
      <Chat client:load />
    </section>

  </div>
</BaseLayout>

<style>
  #greeting {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  #greeting.fade-out {
    opacity: 0;
    transform: translateY(-6px);
  }
  #greeting.fade-in-word {
    opacity: 0;
    transform: translateY(6px);
  }
</style>

<script>
  const greetings = ['Salam', 'Hey', 'Hola', 'Bonjour', '你好', 'Привет', 'नमस्ते'];
  let index = 0; // start at 'Salam' to match initial HTML
  const el = document.getElementById('greeting');

  setInterval(() => {
    index = (index + 1) % greetings.length;

    el?.classList.add('fade-out');
    setTimeout(() => {
      if (el) el.textContent = greetings[index];
      el?.classList.remove('fade-out');
      el?.classList.add('fade-in-word');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => el?.classList.remove('fade-in-word'));
      });
    }, 300);
  }, 2000);
</script>
