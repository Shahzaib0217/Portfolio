---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chat from '../components/Chat';
import ThemeToggle from '../components/ThemeToggle.astro';
import Window from '../components/desktop/Window.astro';
import Glyph, { type GlyphName } from '../components/desktop/Glyph.astro';
import { roles } from '../data/work';
import { profilePage, person } from '../data/site';
import { getPosts } from '../data/posts';

const bridge = roles.find(r => r.company === 'Bridge')!;
const dreamdesk = roles.find(r => r.company === 'DreamDesk AI')!;
const hasPosts = (await getPosts()).length > 0;

const calendly = `if(window.Calendly){Calendly.initPopupWidget({url:'${person.calendly}?hide_gdpr_banner=1'});return false;}`;

interface App {
  label: string;
  glyph: GlyphName;
  /** No-JS fallback, or the destination for apps that are plain links. */
  href: string;
  /** Window the script opens instead of following href. */
  open?: string;
  external?: boolean;
  /** Where the icon shows: desktop icon column, phone home grid, or both. */
  on?: 'desk' | 'phone';
  accent?: boolean;
}

const apps: App[] = [
  { label: 'README.md', glyph: 'doc', open: 'readme', href: '/about' },
  { label: 'Ask my clone', glyph: 'chat', open: 'clone', href: '/about', on: 'desk', accent: true },
  { label: 'Bridge', glyph: 'meet', open: 'bridge', href: '/work#bridge' },
  { label: 'DreamDesk', glyph: 'bell', open: 'dreamdesk', href: '/work#dreamdesk-ai' },
  { label: 'Work', glyph: 'folder', open: 'work', href: '/work' },
  ...(hasPosts ? [{ label: 'Writing', glyph: 'pen', href: '/blog' } as App] : []),
  { label: 'CV.pdf', glyph: 'pdf', href: '/cv' },
  { label: 'About', glyph: 'user', href: '/about', on: 'phone' },
  { label: 'Zehn', glyph: 'school', href: 'https://zehn.school/', external: true, on: 'phone' },
  { label: 'GitHub', glyph: 'github', href: person.github, external: true, on: 'phone' },
  { label: 'Contact', glyph: 'mail', open: 'contact', href: `mailto:${person.email}`, on: 'desk' },
];

// Phone dock: the four things a visitor most likely wants to do.
const dock: App[] = [
  { label: 'Chat', glyph: 'chat', open: 'clone', href: '/about', accent: true },
  { label: 'Email', glyph: 'mail', href: `mailto:${person.email}` },
  { label: 'Book a call', glyph: 'call', href: '/call' },
  { label: 'LinkedIn', glyph: 'linkedin', href: person.linkedin, external: true },
];

const tasks = [
  { id: 'readme', label: 'README.md', glyph: 'doc' },
  { id: 'clone', label: 'Ask my clone', glyph: 'chat' },
  { id: 'bridge', label: 'Bridge', glyph: 'meet' },
  { id: 'dreamdesk', label: 'DreamDesk', glyph: 'bell' },
  { id: 'work', label: 'Work', glyph: 'folder' },
  { id: 'contact', label: 'Contact', glyph: 'mail' },
] as const;

const before = roles.filter(r => !r.current);
---

<BaseLayout
  variant="desktop"
  title="Shahzaib Khan · AI Engineer for AI Agents, Voice AI and MCP"
  ogType="profile"
  jsonLd={[profilePage('/', 'Shahzaib Khan · AI Engineer')]}
>
  <!-- Menu bar (desktop) / status bar (phone) -->
  <header class="menubar">
    <a href="/" class="hidden md:flex items-center gap-2 font-medium" aria-label="Shahzaib Khan, home">
      <img src="/shahzaib-256.webp" alt="" width="28" height="28" class="avatar w-7 h-7" />
      <span class="wordmark text-[1rem]">Shahzaib Khan</span>
    </a>
    <time class="clock md:hidden font-mono text-[0.85rem] font-medium" aria-label="Local time in Lahore">--:--</time>
    <nav class="hidden md:flex items-center gap-1 ml-4" aria-label="Pages">
      <a href="/work" class="menu-link">Work</a>
      <a href="/about" class="menu-link">About</a>
      {hasPosts && <a href="/blog" class="menu-link">Writing</a>}
      <a href="/cv" class="menu-link">CV</a>
    </nav>
    <div class="ml-auto flex items-center gap-2 md:gap-4">
      <div id="presence" class="presence" hidden></div>
      <span class="inline-flex items-center gap-2 text-[0.8rem] whitespace-nowrap"><span class="live-dot"></span><span class="lg:hidden">Open to work</span><span class="hidden lg:inline">Open to new work</span></span>
      <span class="hidden md:inline font-mono text-[0.75rem] text-[var(--color-muted)] whitespace-nowrap">Lahore <time class="clock text-[var(--color-ink)]">--:--</time></span>
      <span class="flex items-center">
        <a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="bar-link hidden md:grid" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn"><Glyph name="linkedin" /></a>
        <a href={person.github} target="_blank" rel="noopener noreferrer" class="bar-link hidden md:grid" aria-label="GitHub (opens in a new tab)" title="GitHub"><Glyph name="github" /></a>
        <ThemeToggle />
      </span>
      <a href="/call" onclick={calendly} class="hidden md:inline-block text-[0.8rem] px-3 py-1 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] font-medium hover:opacity-85 transition-opacity whitespace-nowrap">Book a call</a>
    </div>
  </header>

  <main class="desktop" id="desktop">
    <!-- Other visitors' cursors (see scripts/presence.ts) -->
    <div id="cursors" class="cursors" aria-hidden="true"></div>

    <!-- Phone home screen widget: who I am at a glance -->
    <section class="home-widget" aria-label="Shahzaib Khan at a glance">
      <div class="flex items-center gap-3">
        <img src="/shahzaib-256.webp" alt="Shahzaib Khan" width="48" height="48" class="avatar w-12 h-12" />
        <div class="min-w-0">
          <p class="display text-[1.6rem] leading-none" style="font-variation-settings:'wdth' 80">Shahzaib Khan</p>
          <p class="text-[0.85rem] text-[var(--color-muted)] mt-1">AI engineer · Lahore, Pakistan</p>
        </div>
      </div>
      <p class="mt-3 text-[0.9rem] leading-snug">I build AI agents that run in production: meeting agents, voice agents, RAG and MCP.</p>
      <p class="label mt-4 mb-1">Now</p>
      <ul class="widget-rows">
        <li><button type="button" data-open="bridge"><span><span class="font-medium">Bridge</span><span class="text-[var(--color-muted)]"> · Founding Senior Engineer</span></span><span class="row-go" aria-hidden="true">›</span></button></li>
        <li><button type="button" data-open="dreamdesk"><span><span class="font-medium">DreamDesk AI</span><span class="text-[var(--color-muted)]"> · Lead Product Engineer</span></span><span class="row-go" aria-hidden="true">›</span></button></li>
        <li><a href="https://zehn.school/" target="_blank" rel="noopener noreferrer"><span><span class="font-medium">Zehn</span><span class="text-[var(--color-muted)]"> · Side project</span></span><span class="row-go" aria-hidden="true">↗</span></a></li>
      </ul>
      <button type="button" data-open="readme" class="mt-3 text-[0.85rem] font-medium text-[var(--color-signal)]">Read the full README →</button>
    </section>

    <!-- Icons: desktop column / phone app grid -->
    <nav class="icons" aria-label="Apps">
      {apps.map(app => (
        <a
          href={app.href}
          data-open={app.open}
          class:list={['icon', { 'desk-only': app.on === 'desk', 'phone-only': app.on === 'phone', 'is-accent': app.accent }]}
          draggable="false"
          {...(app.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="icon-tile"><Glyph name={app.glyph} /></span>
          <span class="icon-label">{app.label}</span>
        </a>
      ))}
    </nav>

    <!-- Phone dock -->
    <nav class="dock" aria-label="Quick actions">
      {dock.map(app => (
        <a
          href={app.href}
          data-open={app.open}
          class:list={['icon', { 'is-accent': app.accent }]}
          onclick={app.href === '/call' ? calendly : undefined}
          {...(app.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="icon-tile"><Glyph name={app.glyph} /></span>
          <span class="icon-label">{app.label}</span>
        </a>
      ))}
    </nav>

    <!-- README: open on load, says who I am -->
    <Window id="readme" title="README.md" open width="40rem" x={136} y={28}>
      <div class="flex items-center gap-4">
        <img src="/shahzaib-256.webp" alt="Shahzaib Khan" width="64" height="64" class="avatar w-14 h-14 sm:w-16 sm:h-16" />
        <h1 class="display text-4xl sm:text-5xl">Shahzaib Khan</h1>
      </div>
      <p class="mt-3 text-[1.02rem] leading-relaxed max-w-[52ch]">
        AI engineer from Lahore, Pakistan. I build AI agents that run in production, and have been
        working in AI for 3 years.
      </p>

      <dl class="readme-list mt-6">
        <dt>Now</dt>
        <dd>
          <ul class="space-y-2">
            <li><span class="font-medium">Founding Senior Engineer, <button type="button" data-open="bridge" class="link">Bridge</button></span> <span class="meta">since Aug 2025 · part-time</span><br /><span class="text-[var(--color-muted)]">First engineer. ~500 users.</span></li>
            <li><span class="font-medium">Lead Product Engineer, <button type="button" data-open="dreamdesk" class="link">DreamDesk AI</button></span> <span class="meta">since Jan 2026 · full-time</span><br /><span class="text-[var(--color-muted)]">Voice and chat agents for Second Nature hometels, live at 3 locations.</span></li>
            <li><span class="font-medium"><a href="https://zehn.school/" target="_blank" rel="noopener noreferrer" class="link">Zehn</a>, my side project</span> <span class="meta">since Sep 2026</span><br /><span class="text-[var(--color-muted)]">Computing and AI programmes for schools in Pakistan.</span></li>
          </ul>
        </dd>

        <dt>Before</dt>
        <dd>{before.map((r, i) => <>{i > 0 && ' · '}{r.company === 'Foomotion' ? 'Pearson Labs (YC), via Foomotion' : r.company}</>)}</dd>

        <dt>Stack</dt>
        <dd>Python, TypeScript, Backend (FastAPI, Node.js), Frontend (React, Next.js), AI agents, Voice agents, MCP, GCP, AWS, DigitalOcean, Azure</dd>

        <dt>Studied</dt>
        <dd>BS Computer Science, FAST NUCES, 2024.</dd>

        <dt>Contact</dt>
        <dd class="flex flex-wrap gap-x-4 gap-y-1">
          <a href={`mailto:${person.email}`} class="link">{person.email}</a>
          <a href="/call" onclick={calendly} class="link">Book a call</a>
          <a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="link">LinkedIn</a>
          <a href={person.github} target="_blank" rel="noopener noreferrer" class="link">GitHub</a>
        </dd>
      </dl>

      <div class="mt-6 pt-4 border-t border-[var(--color-rule)] flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-[var(--color-muted)] flex items-center gap-2"><span class="live-dot"></span>Open to new work, remote with US and UK overlap.</p>
        <button type="button" data-open="clone" class="text-sm px-4 py-2 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] font-medium hover:opacity-85 transition-opacity">Ask my AI clone</button>
      </div>
    </Window>

    <!-- Clone -->
    <Window id="clone" title="Ask my clone" width="32rem" height="36rem" x={800} y={28} bodyClass="flex-1 min-h-0">
      <Chat client:idle bare />
    </Window>

    <!-- Bridge -->
    <Window id="bridge" title="bridge.md" width="38rem" x={260} y={70}>
      <p class="label">Aug 2025 – now · Remote, US · Part-time</p>
      <h2 class="display text-4xl mt-2">Bridge</h2>
      <p class="text-[var(--color-muted)]">Founding Senior Engineer · built by Simplora</p>
      <p class="mt-4 leading-relaxed">
        A workspace where teams and AI agents meet: calls, live notes, memory of people and companies,
        and agents that join the meeting and act on what was said. I joined as the first engineer;
        I now lead engineering across product and growth.
      </p>
      <dl class="grid grid-cols-3 gap-px bg-[var(--color-rule)] border border-[var(--color-rule)] rounded-lg overflow-hidden mt-5">
        <div class="bg-[var(--color-panel)] p-3"><dt class="label">MVP</dt><dd class="display text-3xl mt-1">2 mo</dd></div>
        <div class="bg-[var(--color-panel)] p-3"><dt class="label">Users</dt><dd class="display text-3xl mt-1">~500</dd></div>
        <div class="bg-[var(--color-panel)] p-3"><dt class="label">DB queries</dt><dd class="display text-3xl mt-1">30×</dd></div>
      </dl>
      <ul class="mt-5 space-y-2 text-[0.95rem] leading-relaxed">
        {bridge.points.slice(1, 5).map(p => <li class="bullet">{p}</li>)}
      </ul>
      <p class="mt-5 text-sm flex gap-4"><a href="/work#bridge" class="link">Full details</a><a href={bridge.url!} target="_blank" rel="noopener noreferrer" class="link">meetonbridge.com ↗</a></p>
    </Window>

    <!-- DreamDesk -->
    <Window id="dreamdesk" title="dreamdesk.md" width="36rem" x={320} y={110}>
      <p class="label">Jan 2026 – now · Remote, UK · Full-time</p>
      <h2 class="display text-4xl mt-2">DreamDesk AI</h2>
      <p class="text-[var(--color-muted)]">Lead Product Engineer</p>
      <p class="mt-4 leading-relaxed">{dreamdesk.summary}</p>
      <div class="mt-5 rounded-lg border border-[var(--color-rule)] p-4">
        <div class="flex items-baseline justify-between"><p class="label">Voice response time</p><p class="label">incl. RAG + MCP</p></div>
        <p class="display text-5xl mt-2">~1.7s</p>
        <div class="mt-3 h-1.5 rounded-full bg-[var(--color-wash)]"><div class="h-full rounded-full bg-[var(--color-signal)]" style="width:56.7%"></div></div>
        <div class="flex justify-between mt-1.5 font-mono text-[0.65rem] text-[var(--color-muted)]"><span>0s</span><span>1s</span><span>2s</span><span>3s</span></div>
      </div>
      <p class="mt-4 text-[0.95rem]"><span class="label mr-2">Channels</span>Voice · WhatsApp · Email · Web chat</p>
      <p class="mt-1 text-[0.95rem]"><span class="label mr-2">Live at</span>Chiswick (London) · Belfast · Southampton</p>
      <p class="mt-5 text-sm"><a href="/work#dreamdesk-ai" class="link">Full details</a></p>
    </Window>

    <!-- Work -->
    <Window id="work" title="work/" width="34rem" x={380} y={150}>
      <ul>
        {roles.map(r => (
          <li class="grid grid-cols-[8.5rem_1fr] gap-3 py-2.5 border-b border-[var(--color-rule)] last:border-0">
            <span class="meta pt-0.5">{r.period.replace(' – Present', ' – now')}</span>
            <span><span class="font-medium">{r.company}</span><br /><span class="text-sm text-[var(--color-muted)]">{r.role}</span></span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-sm"><a href="/work" class="link">Full work history</a></p>
    </Window>

    <!-- Contact -->
    <Window id="contact" title="contact" width="24rem" x={440} y={190}>
      <p class="leading-relaxed">Open to new work: roles and contracts building AI products. Remote from Lahore, overlapping US and UK hours.</p>
      <ul class="mt-4 space-y-2">
        <li><a href={`mailto:${person.email}`} class="link">{person.email}</a></li>
        <li><a href="/call" onclick={calendly} class="link">Book a 30-minute call</a></li>
        <li><a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="link">LinkedIn</a> · <a href={person.github} target="_blank" rel="noopener noreferrer" class="link">GitHub</a></li>
      </ul>
    </Window>
  </main>

  <!-- Taskbar (desktop): every open window, minimized or not -->
  <footer class="taskbar" aria-label="Open windows">
    <div class="flex items-center gap-1 min-w-0 overflow-x-auto">
      {tasks.map(t => (
        <button type="button" class="task" data-task={t.id} hidden>
          <span class="task-glyph"><Glyph name={t.glyph} /></span>{t.label}
        </button>
      ))}
      <span class="task-empty text-[0.75rem] text-[var(--color-muted)] pl-2" hidden>Nothing open. Pick something on the left.</span>
    </div>
    <span class="ml-auto hidden xl:inline font-mono text-[0.68rem] text-[var(--color-muted)] whitespace-nowrap pr-3">drag windows and icons · double-click to maximize · esc closes</span>
    <button type="button" id="show-desktop" class="show-desktop" aria-label="Minimize all windows" title="Show desktop"></button>
  </footer>
</BaseLayout>

<style is:global>
  .menubar {
    position: sticky; top: 0; z-index: 90;
    display: flex; align-items: center; gap: 0.5rem;
    height: 2.75rem; padding: 0 1rem; flex-shrink: 0;
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-rule);
    font-size: 0.85rem;
  }
  .menu-link { padding: 0.2rem 0.55rem; border-radius: 6px; color: var(--color-muted); }
  .menu-link:hover { color: var(--color-ink); background: var(--color-wash); }
  .bar-link { width: 2rem; height: 2rem; place-items: center; border-radius: 9999px; color: var(--color-muted); transition: color 0.15s, background 0.15s; }
  .bar-link:hover { color: var(--color-ink); background: var(--color-wash); }
  .bar-link svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .desktop {
    position: relative;
    flex: 1;
    background-image: radial-gradient(color-mix(in srgb, var(--color-ink) 9%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  /* Icons */
  .icon { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 0.4rem 0.2rem; border-radius: 10px; text-align: center; }
  .icon:hover .icon-tile { border-color: var(--color-ink); }
  .icon-tile {
    width: 3rem; height: 3rem; display: grid; place-items: center;
    background: var(--color-panel); border: 1px solid var(--color-rule); border-radius: 12px;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ink) 6%, transparent);
    transition: border-color 0.15s, transform 0.15s;
  }
  .icon:active .icon-tile { transform: scale(0.94); }
  .icon-tile svg, .task-glyph svg { fill: none; stroke: var(--color-ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .icon-tile svg { width: 1.5rem; height: 1.5rem; }
  .icon-tile svg .accent { stroke: var(--color-signal); stroke-width: 2.2; }
  .icon.is-accent .icon-tile { background: var(--color-signal); border-color: var(--color-signal); }
  .icon.is-accent .icon-tile svg, .icon.is-accent .icon-tile svg .accent { stroke: #fff; }
  .icon-label { font-size: 0.72rem; line-height: 1.2; padding: 0.05rem 0.3rem; border-radius: 4px; background: color-mix(in srgb, var(--color-paper) 80%, transparent); }
  .icon[aria-current='true'] .icon-label { background: var(--color-ink); color: var(--color-paper); }

  /* Windows */
  .window {
    display: none; flex-direction: column;
    background: var(--color-panel);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--color-ink) 6%, transparent), 0 12px 32px -12px color-mix(in srgb, var(--color-ink) 22%, transparent);
    overflow: hidden;
  }
  .window.is-open:not(.is-min) { display: flex; }
  .window:focus { outline: none; }
  .window-bar {
    display: flex; align-items: center; gap: 0.5rem;
    height: 2.25rem; padding: 0 0.35rem 0 0.9rem; flex-shrink: 0;
    background: var(--color-wash); border-bottom: 1px solid var(--color-rule);
    user-select: none;
  }
  .window.is-active .window-bar { background: color-mix(in srgb, var(--color-wash) 55%, var(--color-panel)); }
  .window-title { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .window.is-active .window-title { color: var(--color-ink); }
  .window-ctrls { margin-left: auto; display: flex; gap: 0.1rem; }
  .window-ctrls button { width: 1.75rem; height: 1.6rem; display: grid; place-items: center; border-radius: 6px; color: var(--color-muted); }
  .window-ctrls button:hover { background: var(--color-rule); color: var(--color-ink); }
  .window-ctrls [data-close]:hover { background: #E5484D; color: #fff; }
  .window-back { display: none; }
  .window-ctrls .i-restore, .window.is-max .window-ctrls .i-max { display: none; }
  .window.is-max .window-ctrls .i-restore { display: block; }
  .window-body { overflow: auto; }

  .readme-list { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.9rem 1rem; font-size: 0.95rem; line-height: 1.55; }
  .readme-list dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); padding-top: 0.2rem; }
  .meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-muted); white-space: nowrap; }
  .bullet { padding-left: 1rem; position: relative; }
  .bullet::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 0.4rem; height: 1px; background: var(--color-muted); }
  button.link { font: inherit; color: inherit; }

  /* Presence: other visitors as anonymous animals */
  .presence { display: flex; align-items: center; }
  .presence[hidden] { display: none; }
  .peer {
    width: 1.6rem; height: 1.6rem; display: grid; place-items: center; flex-shrink: 0;
    border-radius: 9999px; font-size: 0.85rem; line-height: 1;
    background: color-mix(in srgb, var(--c, var(--color-muted)) 22%, var(--color-panel));
    box-shadow: 0 0 0 2px var(--color-paper), 0 0 0 3.5px var(--c, var(--color-rule));
    animation: peer-in 0.25s ease-out;
  }
  .peer + .peer { margin-left: 0.2rem; }
  .peer-more { font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-muted); background: var(--color-wash); }
  @keyframes peer-in { from { transform: scale(0.4); opacity: 0; } }
  .cursors { display: none; }
  .peer-cursor {
    position: absolute; left: 0; top: 0; pointer-events: none;
    transition: transform 0.12s linear, opacity 0.4s;
  }
  .peer-cursor span {
    position: absolute; left: 14px; top: 16px; white-space: nowrap;
    padding: 0.1rem 0.45rem; border-radius: 6px; font-size: 0.72rem; font-weight: 500;
    background: var(--c); color: #fff;
  }
  .peer-cursor.is-idle { opacity: 0.35; }

  /* Taskbar */
  .taskbar { display: none; }
  .task[hidden], .task-empty[hidden] { display: none; }

  /* ---------- Phone: home screen ---------- */
  @media (max-width: 767px) {
    .desk-only { display: none !important; }
    .desktop { padding: 1rem 1rem calc(7rem + env(safe-area-inset-bottom)); min-height: calc(100dvh - 2.75rem); }

    .home-widget {
      position: relative;
      padding: 1rem 1.1rem 1.1rem;
      background: color-mix(in srgb, var(--color-panel) 92%, transparent);
      backdrop-filter: blur(8px);
      border: 1px solid var(--color-rule); border-radius: 22px;
      box-shadow: 0 8px 24px -16px color-mix(in srgb, var(--color-ink) 30%, transparent);
    }
    .widget-rows li + li { border-top: 1px solid var(--color-rule); }
    .widget-rows button, .widget-rows a { width: 100%; display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; padding: 0.55rem 0; font-size: 0.88rem; text-align: left; }
    .widget-rows .row-go { color: var(--color-muted); font-size: 1rem; line-height: 1; }

    .icons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem 0.25rem; margin-top: 1.5rem; }
    .icon-tile { width: 3.6rem; height: 3.6rem; border-radius: 16px; }
    .icon-tile svg { width: 1.7rem; height: 1.7rem; }
    .icon-label { background: none; font-size: 0.74rem; }

    .dock {
      position: fixed; z-index: 60; left: 0.75rem; right: 0.75rem; bottom: calc(0.75rem + env(safe-area-inset-bottom));
      display: grid; grid-template-columns: repeat(4, 1fr);
      padding: 0.6rem 0.4rem 0.45rem;
      background: color-mix(in srgb, var(--color-panel) 75%, transparent);
      backdrop-filter: blur(14px);
      border: 1px solid var(--color-rule); border-radius: 26px;
    }
    .dock .icon { padding: 0; }
    .dock .icon-label { font-size: 0.68rem; color: var(--color-muted); }

    /* Apps open as sheets under the status bar. !important beats the window manager's inline z-index. */
    .window { position: fixed; inset: 2.75rem 0 0 0; z-index: 80 !important; border-radius: 0; border: 0; box-shadow: none; }
    .window-bar { display: grid; grid-template-columns: 1fr auto 1fr; height: 3rem; padding: 0 0.5rem; background: var(--color-panel) !important; }
    .window-back { display: inline-flex; align-items: center; gap: 0.35rem; justify-self: start; padding: 0.4rem 0.5rem; font-size: 0.95rem; color: var(--color-signal); }
    .window-title { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 500; color: var(--color-ink); }
    .window-ctrls { display: none; }
    .window-body { flex: 1; }
    .readme-list { grid-template-columns: 1fr; gap: 0.2rem; }
    .readme-list dd { margin-bottom: 0.7rem; }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 768px) {
    .phone-only, .home-widget, .dock { display: none !important; }
    body { height: 100dvh; overflow: hidden; }
    .desktop { overflow: hidden; }
    .icons { position: absolute; left: 0.75rem; top: 1rem; display: flex; flex-direction: column; gap: 0.5rem; width: 6rem; z-index: 1; }
    /* Once an icon is dragged, every icon is placed absolutely on a grid (until the page reloads) */
    .icons.is-free { inset: 0; width: auto; display: block; pointer-events: none; }
    .icons.is-free .icon { position: absolute; width: 6rem; pointer-events: auto; }
    .icon { -webkit-user-drag: none; user-select: none; }
    .icon.is-dragging { z-index: 2; cursor: grabbing; transition: none; }
    .icon.is-dragging .icon-tile { box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--color-ink) 45%, transparent); transform: scale(1.06); }
    .icons.is-free .icon:not(.is-dragging) { transition: left 0.18s ease, top 0.18s ease; }
    .cursors { display: block; position: absolute; inset: 0; z-index: 9000; pointer-events: none; overflow: hidden; }

    .window, .window.desk-open { position: absolute; left: var(--x); top: var(--y); width: min(var(--w), calc(100% - 9rem)); height: var(--h, auto); max-height: calc(100% - var(--y) - 1rem); }
    .window.desk-open { display: flex; }
    .window.is-max { left: 0 !important; top: 0 !important; width: 100%; height: 100%; max-height: none !important; border-radius: 0; border-width: 0; }
    .window-bar { cursor: grab; }
    .window.is-max .window-bar { cursor: default; }
    .window.is-dragging .window-bar { cursor: grabbing; }

    .taskbar {
      display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0;
      height: 2.6rem; padding-left: 0.5rem;
      background: color-mix(in srgb, var(--color-paper) 88%, transparent);
      border-top: 1px solid var(--color-rule);
    }
    .task {
      display: inline-flex; align-items: center; gap: 0.45rem;
      height: 1.95rem; padding: 0 0.7rem 0 0.5rem; border-radius: 7px;
      font-size: 0.78rem; white-space: nowrap; color: var(--color-muted);
      position: relative;
    }
    .task:hover { background: var(--color-wash); color: var(--color-ink); }
    .task-glyph svg { width: 1rem; height: 1rem; stroke: currentColor; }
    .task.is-active { background: var(--color-panel); color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-rule); }
    .task.is-active::after { content: ''; position: absolute; left: 0.6rem; right: 0.6rem; bottom: 2px; height: 2px; border-radius: 2px; background: var(--color-signal); }
    .task.is-min { opacity: 0.6; }
    .show-desktop { width: 0.6rem; align-self: stretch; border-left: 1px solid var(--color-rule); }
    .show-desktop:hover { background: var(--color-wash); }
  }
</style>

<script>
  import { startPresence } from '../scripts/presence';

  const desktop = document.getElementById('desktop')!;
  const wide = matchMedia('(min-width: 768px)');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const windows = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-window]').forEach(w => windows.set(w.id, w));
  const tasks = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-task]').forEach(t => tasks.set(t.dataset.task!, t));

  let z = 10;
  const isVisible = (w: HTMLElement) => w.classList.contains('is-open') && !w.classList.contains('is-min');

  function sync() {
    let anyOpen = false;
    windows.forEach((w, id) => {
      const open = w.classList.contains('is-open');
      anyOpen ||= open;
      document.querySelectorAll<HTMLElement>(`.icons .icon[data-open="${id}"]`).forEach(i => i.setAttribute('aria-current', String(open)));
      const t = tasks.get(id);
      if (!t) return;
      t.hidden = !open;
      t.classList.toggle('is-min', w.classList.contains('is-min'));
      t.classList.toggle('is-active', isVisible(w) && w.classList.contains('is-active'));
      t.setAttribute('aria-pressed', String(isVisible(w)));
    });
    (document.querySelector('.task-empty') as HTMLElement).hidden = anyOpen;
  }

  function focusWindow(w: HTMLElement) {
    windows.forEach(other => other.classList.remove('is-active'));
    w.classList.add('is-active');
    w.style.zIndex = String(++z);
    sync();
  }

  function focusTop() {
    const top = [...windows.values()].filter(isVisible).sort((a, b) => Number(b.style.zIndex || 0) - Number(a.style.zIndex || 0))[0];
    if (top) { focusWindow(top); top.focus({ preventScroll: true }); }
  }

  function animateIn(w: HTMLElement) {
    if (calm.matches) return;
    const from = wide.matches ? 'translateY(10px) scale(0.98)' : 'translateY(32px)';
    w.animate([{ transform: from, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: wide.matches ? 160 : 220, easing: 'cubic-bezier(.2,.8,.2,1)' });
  }

  function openWindow(id: string, { updateHash = true, focus = true } = {}) {
    const w = windows.get(id);
    if (!w) return;
    const wasVisible = isVisible(w);
    w.classList.add('is-open');
    w.classList.remove('is-min');
    if (!wasVisible) {
      animateIn(w);
      // Keep windows inside the desktop on narrower screens.
      if (wide.matches && !w.classList.contains('is-max')) {
        const maxLeft = desktop.clientWidth - w.offsetWidth - 16;
        if (w.offsetLeft > maxLeft) w.style.left = `${Math.max(maxLeft, 112)}px`;
      }
    }
    if (!wide.matches) {
      // Phone: one app at a time, like a phone.
      windows.forEach(o => o !== w && o.classList.remove('is-open'));
      document.body.style.overflow = 'hidden';
      if (updateHash && location.hash !== `#${id}`) history.pushState({ sheet: true }, '', `#${id}`);
    } else if (updateHash) {
      history.replaceState(null, '', id === 'readme' ? location.pathname : `#${id}`);
    }
    if (!focus) { w.style.zIndex = String(++z - 2); sync(); return; }
    focusWindow(w);
    w.focus({ preventScroll: true });
  }

  function closeWindow(w: HTMLElement, { fromHistory = false } = {}) {
    w.classList.remove('is-open', 'is-active', 'is-min', 'is-max');
    if (!wide.matches) document.body.style.overflow = '';
    if (!fromHistory && location.hash === `#${w.id}`) {
      if (!wide.matches && history.state?.sheet) history.back();
      else history.replaceState(null, '', location.pathname);
    }
    focusTop();
    sync();
  }

  function minimizeWindow(w: HTMLElement) {
    let anim: Animation | undefined;
    const done = () => {
      w.classList.add('is-min');
      anim?.cancel();
      w.classList.remove('is-active');
      if (location.hash === `#${w.id}`) history.replaceState(null, '', location.pathname);
      focusTop();
      sync();
    };
    if (calm.matches) return done();
    let finished = false;
    const finish = () => { if (!finished) { finished = true; done(); } };
    // Animations can stall in background tabs; don't let that block the minimize.
    setTimeout(finish, 300);
    // Drop toward the matching taskbar button.
    const task = tasks.get(w.id)!.getBoundingClientRect();
    const rect = w.getBoundingClientRect();
    const dx = task.left + task.width / 2 - (rect.left + rect.width / 2);
    const dy = task.top - rect.top;
    anim = w.animate([{ transform: 'none', opacity: 1 }, { transform: `translate(${dx}px, ${dy}px) scale(0.15)`, opacity: 0 }], { duration: 220, easing: 'cubic-bezier(.4,0,.8,.6)', fill: 'forwards' });
    anim.finished.then(finish, finish);
  }

  function toggleMax(w: HTMLElement) {
    const max = w.classList.toggle('is-max');
    const btn = w.querySelector<HTMLElement>('[data-max]')!;
    const name = w.getAttribute('aria-label');
    btn.setAttribute('aria-label', `${max ? 'Restore' : 'Maximize'} ${name}`);
    btn.title = max ? 'Restore' : 'Maximize';
    focusWindow(w);
  }

  // Opening, closing, minimizing, maximizing
  document.addEventListener('click', e => {
    const target = e.target as Element;
    const opener = target.closest<HTMLElement>('[data-open]');
    if (opener?.dataset.open && windows.has(opener.dataset.open)) {
      e.preventDefault();
      openWindow(opener.dataset.open);
      return;
    }
    const w = target.closest<HTMLElement>('[data-window]');
    if (!w) return;
    if (target.closest('[data-close]')) closeWindow(w);
    else if (target.closest('[data-min]')) minimizeWindow(w);
    else if (target.closest('[data-max]')) toggleMax(w);
  });

  // Taskbar: restore a minimized window, minimize the active one, or bring one forward
  tasks.forEach((t, id) => t.addEventListener('click', () => {
    const w = windows.get(id)!;
    if (w.classList.contains('is-min')) { w.classList.remove('is-min'); animateIn(w); focusWindow(w); w.focus({ preventScroll: true }); }
    else if (w.classList.contains('is-active')) minimizeWindow(w);
    else { focusWindow(w); w.focus({ preventScroll: true }); }
  }));
  document.getElementById('show-desktop')!.addEventListener('click', () => {
    const visible = [...windows.values()].filter(isVisible);
    visible.forEach(w => w.classList.add('is-min'));
    windows.forEach(w => w.classList.remove('is-active'));
    history.replaceState(null, '', location.pathname);
    sync();
  });

  // Bring to front on interaction
  windows.forEach(w => w.addEventListener('pointerdown', () => { if (!w.classList.contains('is-active')) focusWindow(w); }));

  // Title bar: drag to move, double-click to maximize (desktop only)
  document.querySelectorAll<HTMLElement>('[data-drag]').forEach(bar => {
    const w = bar.closest<HTMLElement>('[data-window]')!;
    bar.addEventListener('dblclick', e => {
      if (wide.matches && !(e.target as Element).closest('button')) toggleMax(w);
    });
    bar.addEventListener('pointerdown', e => {
      if (!wide.matches || e.button !== 0 || w.classList.contains('is-max') || (e.target as Element).closest('button')) return;
      const area = desktop.getBoundingClientRect();
      const rect = w.getBoundingClientRect();
      const dx = e.clientX - rect.left;
      const dy = e.clientY - rect.top;
      bar.setPointerCapture(e.pointerId);
      w.classList.add('is-dragging');

      const move = (ev: PointerEvent) => {
        const x = Math.min(Math.max(ev.clientX - area.left - dx, 80 - rect.width), area.width - 80);
        const y = Math.min(Math.max(ev.clientY - area.top - dy, 0), area.height - 40);
        w.style.left = `${x}px`;
        w.style.top = `${y}px`;
        w.style.maxHeight = `${area.height - y - 16}px`;
      };
      const up = () => {
        w.classList.remove('is-dragging');
        bar.removeEventListener('pointermove', move);
        bar.removeEventListener('pointerup', up);
        bar.removeEventListener('pointercancel', up);
      };
      bar.addEventListener('pointermove', move);
      bar.addEventListener('pointerup', up);
      bar.addEventListener('pointercancel', up);
    });
  });

  // Esc closes the active window (or the open app on phones)
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    const active = document.querySelector<HTMLElement>('.window.is-active.is-open:not(.is-min)');
    if (active) closeWindow(active);
  });

  // Phone back button closes the open app; forward reopens it
  addEventListener('popstate', () => {
    const id = location.hash.slice(1);
    windows.forEach(w => { if (w.id !== id && w.classList.contains('is-open')) closeWindow(w, { fromHistory: true }); });
    if (windows.has(id)) openWindow(id, { updateHash: false });
  });

  // Initial state. `desk-open` windows show without JS on desktop; hand them to the window manager.
  const bootOpen = [...document.querySelectorAll<HTMLElement>('.window.desk-open')];
  bootOpen.forEach(w => w.classList.remove('desk-open'));
  const fromHash = location.hash.slice(1);
  if (wide.matches) bootOpen.forEach(w => openWindow(w.id, { updateHash: false }));
  if (windows.has(fromHash)) openWindow(fromHash, { updateHash: false });
  // Big screens have room for the clone next to the README.
  else if (matchMedia('(min-width: 1360px)').matches) {
    openWindow('clone', { updateHash: false, focus: false });
    // Pin it to the right edge so it never runs off narrower large screens.
    const clone = windows.get('clone')!;
    clone.style.left = `${Math.max(desktop.clientWidth - clone.offsetWidth - 24, 136 + 24)}px`;
  }
  sync();

  // Desktop icons: drag to rearrange on a grid. Positions live only in memory, so a reload resets them.
  const iconNav = document.querySelector<HTMLElement>('.icons')!;
  const deskIcons = () => [...iconNav.querySelectorAll<HTMLElement>('.icon')].filter(i => i.offsetParent);
  let grid: { x0: number; y0: number; w: number; h: number } | null = null;
  const cells = new Map<HTMLElement, { col: number; row: number }>();

  function freeIcons() {
    if (grid) return;
    const icons = deskIcons();
    const area = desktop.getBoundingClientRect();
    const rects = icons.map(i => i.getBoundingClientRect());
    grid = { x0: rects[0].left - area.left, y0: rects[0].top - area.top, w: rects[0].width + 8, h: rects[1].top - rects[0].top };
    iconNav.classList.add('is-free');
    icons.forEach((icon, row) => place(icon, 0, row));
  }

  function place(icon: HTMLElement, col: number, row: number) {
    cells.set(icon, { col, row });
    icon.style.left = `${grid!.x0 + col * grid!.w}px`;
    icon.style.top = `${grid!.y0 + row * grid!.h}px`;
  }

  let suppressClick = false;
  iconNav.addEventListener('click', e => {
    if (suppressClick) { e.preventDefault(); e.stopImmediatePropagation(); suppressClick = false; }
  }, true);

  iconNav.addEventListener('pointerdown', e => {
    const icon = (e.target as Element).closest<HTMLElement>('.icon');
    if (!icon || !wide.matches || e.button !== 0 || e.pointerType === 'touch') return;
    const startX = e.clientX, startY = e.clientY;
    let dragging = false;
    let offX = 0, offY = 0;

    const move = (ev: PointerEvent) => {
      if (!dragging) {
        if (Math.hypot(ev.clientX - startX, ev.clientY - startY) < 5) return;
        dragging = true;
        freeIcons();
        icon.classList.add('is-dragging');
        const r = icon.getBoundingClientRect();
        offX = startX - r.left;
        offY = startY - r.top;
      }
      const area = desktop.getBoundingClientRect();
      icon.style.left = `${Math.min(Math.max(ev.clientX - area.left - offX, 0), area.width - icon.offsetWidth)}px`;
      icon.style.top = `${Math.min(Math.max(ev.clientY - area.top - offY, 0), area.height - icon.offsetHeight)}px`;
    };

    // Listen on the window: a quick flick can leave the icon before the drag starts.
    const up = () => {
      removeEventListener('pointermove', move);
      removeEventListener('pointerup', up);
      removeEventListener('pointercancel', up);
      if (!dragging) return;
      suppressClick = true;
      setTimeout(() => (suppressClick = false), 0);
      icon.classList.remove('is-dragging');
      // Snap to the nearest cell; swap with an icon that's already there.
      const g = grid!;
      const maxCol = Math.max(0, Math.floor((desktop.clientWidth - g.x0 - icon.offsetWidth) / g.w));
      const maxRow = Math.max(0, Math.floor((desktop.clientHeight - g.y0 - icon.offsetHeight) / g.h));
      const col = Math.min(Math.max(Math.round((icon.offsetLeft - g.x0) / g.w), 0), maxCol);
      const row = Math.min(Math.max(Math.round((icon.offsetTop - g.y0) / g.h), 0), maxRow);
      const from = cells.get(icon)!;
      const other = [...cells].find(([o, c]) => o !== icon && c.col === col && c.row === row)?.[0];
      if (other) place(other, from.col, from.row);
      place(icon, col, row);
    };

    addEventListener('pointermove', move);
    addEventListener('pointerup', up);
    addEventListener('pointercancel', up);
  });

  startPresence();

  // Local time in Lahore
  const clocks = document.querySelectorAll('.clock');
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Karachi' });
  const tick = () => { const t = fmt.format(new Date()); clocks.forEach(c => (c.textContent = t)); };
  tick();
  setInterval(tick, 15_000);
</script>
