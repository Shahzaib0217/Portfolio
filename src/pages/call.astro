---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book a call · Shahzaib Khan"
  description="Schedule a 30-minute call with Shahzaib Khan."
>
  <section class="min-h-[calc(100dvh-10rem)] flex flex-col justify-center py-16 fade-in">
    <p class="label">30 minutes · Video call</p>
    <h1 class="display text-5xl sm:text-7xl mt-4 max-w-[14ch]">Let's talk about what you're building.</h1>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="https://calendly.com/shahzaib-khan0217/30min"
        onclick="if(window.Calendly){Calendly.initPopupWidget({url:'https://calendly.com/shahzaib-khan0217/30min?hide_gdpr_banner=1'});return false;}"
        class="text-sm px-5 py-3 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] font-medium hover:opacity-85 transition-opacity"
      >
        Pick a time
      </a>
      <a href="mailto:hello@shahzaib.ai" class="text-sm px-5 py-3 rounded-full border border-[var(--color-rule)] font-medium hover:border-[var(--color-ink)] transition-colors">
        Or email hello@shahzaib.ai
      </a>
    </div>
  </section>
</BaseLayout>
