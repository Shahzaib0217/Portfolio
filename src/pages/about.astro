---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profilePage, faqPage, person, PERSON_ID } from '../data/site';

const faqs = [
  {
    q: 'What does Shahzaib Khan do?',
    a: 'I\'m an AI engineer. I build AI agents that run in production: meeting agents at Bridge, guest-service voice and chat agents at DreamDesk AI, and the RAG pipelines, MCP integrations, backend and infrastructure behind them.',
  },
  {
    q: 'Is Shahzaib Khan open to new work?',
    a: `Yes. I'm open to roles and contracts building AI products. I work remotely from Pakistan (PKT) and overlap with US and UK working hours. Email ${person.email} or book a call at ${person.calendly}.`,
  },
  {
    q: 'What kind of AI systems has he built?',
    a: 'Agentic workflows with LangChain, LangGraph and Pydantic AI; voice agents with LiveKit, VAPI, AssemblyAI and Deepgram; RAG pipelines on Pinecone and pgvector; and MCP integrations with ClickUp, Slack, Google Drive and Notion. I ship them full stack with FastAPI, Node.js and Next.js on GCP, AWS and DigitalOcean.',
  },
  {
    q: 'Where is Shahzaib Khan based?',
    a: 'Pakistan. I work remotely with teams in the US and UK.',
  },
  {
    q: 'What is Bridge?',
    a: 'Bridge (meetonbridge.com) is a workspace where teams and AI agents meet: calls, live notes, memory of people and companies, and agents that join meetings and act on what was said. I joined as its first engineer in August 2025 and became Founding Senior Engineer in October 2026.',
  },
];

const stack = [
  { area: 'AI and agents', items: 'LangChain, LangGraph, LlamaIndex, Pydantic AI, RAG, MCP servers, AWS Bedrock' },
  { area: 'Voice', items: 'LiveKit, VAPI, AssemblyAI, Deepgram, TTS and voice cloning' },
  { area: 'Backend', items: 'FastAPI, Node.js, gRPC, REST' },
  { area: 'Frontend', items: 'Next.js, React, TypeScript' },
  { area: 'Data', items: 'PostgreSQL, MongoDB, Redis, Supabase, Pinecone, pgvector' },
  { area: 'Infra', items: 'Docker, GCP Cloud Run, AWS EC2 and S3, DigitalOcean, Nginx, GitHub Actions' },
];

const principles = [
  { title: 'Ship to real users early', body: 'Bridge went from first commit to MVP in two months. DreamDesk had a working proof of concept in four weeks. Feedback from people using it beats a perfect spec.' },
  { title: 'Own it end to end', body: 'Architecture, backend, frontend, AI pipelines, infra and CI/CD. I also write the specs, plan the sprints and lead the engineers.' },
];
---

<BaseLayout
  title="About Shahzaib Khan · AI Engineer"
  description="About Shahzaib Khan, an AI engineer from Pakistan: Bridge, DreamDesk AI and Zehn, how he works, his stack, education and research."
  ogType="profile"
  jsonLd={[
    profilePage('/about', 'About Shahzaib Khan'),
    faqPage('/about', faqs),
    {
      '@type': 'ScholarlyArticle',
      '@id': 'https://arxiv.org/abs/2607.23308',
      name: 'Towards LLM-assisted High-Quality Property Generation for Solidity Smart Contracts',
      url: 'https://arxiv.org/abs/2607.23308',
      sameAs: 'https://doi.org/10.48550/arXiv.2607.23308',
      datePublished: '2026-07-25',
      publisher: { '@type': 'Organization', name: 'arXiv' },
      author: ['Muhammad Wahid', { '@id': PERSON_ID }, 'Mashhood Ali', 'Muhammad Hassan', 'Muhammad Naiman Jalil', 'Affan Rauf'].map(a => typeof a === 'string' ? { '@type': 'Person', name: a } : a),
    },
  ]}
>
  <section class="pt-12 sm:pt-20 pb-14 grid lg:grid-cols-12 gap-10 lg:gap-12 items-end fade-in">
    <div class="lg:col-span-8">
      <p class="label">About</p>
      <h1 class="display text-5xl sm:text-7xl mt-4 max-w-[16ch]">Hi, I'm Shahzaib.</h1>
    </div>
    <div class="lg:col-span-4">
      <img
        src="/shahzaib.jpg?v=2"
        alt="Portrait of Shahzaib Khan"
        width="320"
        height="320"
        class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl object-cover border border-[var(--color-rule)]"
      />
    </div>
  </section>

  <section class="grid lg:grid-cols-12 gap-10 lg:gap-12 pb-16 border-t border-[var(--color-ink)] pt-10">
    <div class="lg:col-span-4">
      <p class="label">The short version</p>
    </div>
    <div class="lg:col-span-8 space-y-5 text-lg leading-relaxed max-w-[62ch]">
      <p>
        I'm Shahzaib, a full-stack AI engineer from Pakistan. Since graduating from FAST NUCES in 2024 I've been
        an engineer, often the first or lead one, at AI startups in the US, UK and Europe, across meetings, hospitality,
        legal tech, AI governance and security.
      </p>
      <p class="text-[var(--color-muted)]">
        My best work so far is <a href="/#bridge" class="link text-[var(--color-ink)]">Bridge</a>. I joined as the first engineer,
        shipped the MVP, grew it to ~500 users, and now lead engineering across product and growth as Founding Senior Engineer.
        At <a href="/#dreamdesk" class="link text-[var(--color-ink)]">DreamDesk AI</a> I lead the team building guest-service agents for Second Nature, DreamDesk's parent company, live across its hometels.
      </p>
      <p class="text-[var(--color-muted)]">
        In September 2026 I started <a href="https://zehn.school/" target="_blank" rel="noopener noreferrer" class="link text-[var(--color-ink)]">Zehn</a>, a side project teaching schools and colleges in Pakistan
        to build with AI. It keeps me close to the part of a company that isn't code: selling, teaching and earning trust.
      </p>
      <p class="text-[var(--color-muted)]">
        Outside of work, I'm driven by my faith. It shapes how I build, lead and treat the people I work with.
      </p>
    </div>
  </section>

  <section class="grid lg:grid-cols-12 gap-10 lg:gap-12 pb-16 border-t border-[var(--color-rule)] pt-10">
    <div class="lg:col-span-4">
      <h2 class="label">How I work</h2>
    </div>
    <div class="lg:col-span-8 grid gap-8">
      {principles.map(p => (
        <div>
          <h3 class="display text-2xl sm:text-3xl">{p.title}</h3>
          <p class="mt-2 text-[var(--color-muted)] leading-relaxed max-w-[60ch]">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="grid lg:grid-cols-12 gap-10 lg:gap-12 pb-16 border-t border-[var(--color-rule)] pt-10">
    <div class="lg:col-span-4">
      <p class="label">Stack</p>
    </div>
    <dl class="lg:col-span-8">
      {stack.map(s => (
        <div class="grid sm:grid-cols-[10rem_1fr] gap-1 sm:gap-6 py-3 border-b border-[var(--color-rule)] first:pt-0">
          <dt class="font-medium">{s.area}</dt>
          <dd class="text-[var(--color-muted)]">{s.items}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="grid lg:grid-cols-12 gap-10 lg:gap-12 pb-20 border-t border-[var(--color-rule)] pt-10">
    <div class="lg:col-span-4">
      <p class="label">Education and research</p>
    </div>
    <div class="lg:col-span-8">
      <p class="font-medium">BS Computer Science, FAST NUCES · 2024</p>
      <div class="mt-6 rounded-xl border border-[var(--color-rule)] bg-[var(--color-panel)] p-5 sm:p-6">
        <p class="label">Paper · arXiv · Jul 2026</p>
        <h2 class="mt-2 font-medium text-lg leading-snug"><a href="https://arxiv.org/abs/2607.23308" target="_blank" rel="noopener noreferrer" class="link">Towards LLM-assisted High-Quality Property Generation for Solidity Smart Contracts</a></h2>
        <p class="mt-1 text-sm text-[var(--color-muted)]">Co-author · with Dr. Hassan (DFKI Bremen) and Dr. Jalil (UAEU)</p>
        <ul class="mt-4 space-y-2 text-[0.95rem] text-[var(--color-muted)] leading-relaxed">
          <li>An LLM pipeline that generates test invariants for property-based testing of Solidity contracts.</li>
          <li>An agent that automatically fixes compilation errors in the generated properties.</li>
          <li>Evaluated with mutation testing: Gemini 1.5 Pro with prompt chaining reached a 25.99% mutation score vs 31.75% for hand-written properties, and matched them on some contracts.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="grid lg:grid-cols-12 gap-10 lg:gap-12 pb-20 border-t border-[var(--color-rule)] pt-10" aria-labelledby="faq-heading">
    <div class="lg:col-span-4">
      <h2 id="faq-heading" class="label">Questions</h2>
    </div>
    <div class="lg:col-span-8">
      {faqs.map(f => (
        <details class="group border-b border-[var(--color-rule)] py-4 first:pt-0">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium">
            <h3>{f.q}</h3>
            <span class="text-[var(--color-muted)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-[var(--color-muted)] leading-relaxed max-w-[62ch]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="pb-24 border-t border-[var(--color-ink)] pt-10">
    <h2 class="display text-4xl sm:text-5xl">Say hello</h2>
    <p class="mt-3 text-[var(--color-muted)]">Want to build something together, talk about AI, or just compare notes?</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/call"
        onclick="return window.openCalendly ? openCalendly() : true"
        class="text-sm px-5 py-3 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] font-medium hover:opacity-85 transition-opacity"
      >
        Book a 30-minute call
      </a>
      <a href="mailto:hello@shahzaib.ai" class="text-sm px-5 py-3 rounded-full border border-[var(--color-rule)] font-medium hover:border-[var(--color-ink)] transition-colors">
        hello@shahzaib.ai
      </a>
    </div>
  </section>
</BaseLayout>
