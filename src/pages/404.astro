---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Shahzaib" description="Page not found.">
  <div class="pt-24 pb-16 text-center fade-in">
    <p class="text-6xl mb-6" style="font-family: var(--font-serif)">404</p>
    <h1 class="text-xl font-medium mb-3">Page not found</h1>
    <p class="text-[var(--color-muted)] mb-8">
      This page doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="text-sm underline underline-offset-2 text-[var(--color-ink)] hover:opacity-70 transition-opacity"
    >
      Go home
    </a>
  </div>
</BaseLayout>
