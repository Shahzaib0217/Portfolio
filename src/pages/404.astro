---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · Shahzaib Khan" description="This page doesn't exist.">
  <section class="min-h-[calc(100dvh-10rem)] flex flex-col justify-center py-16 fade-in">
    <p class="label">Error 404</p>
    <h1 class="display text-5xl sm:text-7xl mt-4">This page doesn't exist.</h1>
    <p class="mt-4 text-[var(--color-muted)]">It may have moved, or the link has a typo.</p>
    <a href="/" class="mt-8 self-start text-sm px-5 py-3 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] font-medium hover:opacity-85 transition-opacity">
      Go to the home page
    </a>
  </section>
</BaseLayout>
