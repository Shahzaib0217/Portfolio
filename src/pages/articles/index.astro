---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Articles — Shahzaib"
  description="Writing on AI, software engineering, and building products."
>
  <div class="pt-12 fade-in">
    <h1 class="text-3xl mb-2 leading-tight" style="font-family: var(--font-serif)">
      Articles
    </h1>
    <p class="text-[var(--color-muted)] mb-10">
      Thoughts on AI, software, and building products.
    </p>

    {articles.length === 0 ? (
      <p class="text-[var(--color-muted)]">No articles yet. Coming soon.</p>
    ) : (
      <div class="flex flex-col divide-y divide-[var(--color-border)]">
        {articles.map((article, i) => {
          const date = new Date(article.data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <a
              href={`/articles/${article.id}`}
              class={`py-6 group flex items-start justify-between gap-6 hover:opacity-80 transition-opacity fade-in fade-in-delay-${Math.min(i + 1, 4)}`}
            >
              <div>
                <h2 class="text-base font-medium mb-1 group-hover:underline underline-offset-2">
                  {article.data.title}
                </h2>
                <p class="text-sm text-[var(--color-muted)] leading-relaxed">
                  {article.data.description}
                </p>
              </div>
              <div class="text-right flex-shrink-0">
                <time class="text-sm text-[var(--color-muted)]" datetime={article.data.date}>
                  {date}
                </time>
                {article.data.readTime && (
                  <p class="text-xs text-[var(--color-muted)] mt-0.5">{article.data.readTime}</p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
