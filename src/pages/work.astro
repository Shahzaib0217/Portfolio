---
import BaseLayout from '../layouts/BaseLayout.astro';
import { roles } from '../data/work';
import { profilePage } from '../data/site';
---

<BaseLayout
  title="Work · Shahzaib Khan, AI Engineer"
  description="Shahzaib Khan's work history: Founding Senior Engineer at Bridge, Lead Product Engineer at DreamDesk AI, Zehn, and earlier AI engineering roles in the US, UK and Europe."
  jsonLd={[profilePage('/work', 'Work history of Shahzaib Khan')]}
>
  <section class="pt-12 sm:pt-20 pb-10 fade-in">
    <p class="label">Work history · 2024 – now</p>
    <h1 class="display text-5xl sm:text-7xl mt-4">Work</h1>
    <p class="mt-5 text-lg text-[var(--color-muted)] leading-relaxed max-w-[52ch]">
      Engineering roles at AI startups in the US, UK and Europe, most of them as the first or lead engineer, and the company I'm building in Pakistan.
    </p>
  </section>

  <div class="border-t border-[var(--color-ink)] pb-20">
    {roles.map(job => (
      <article id={job.company.toLowerCase().replace(/\s+/g, '-')} class="scroll-mt-20 grid lg:grid-cols-12 gap-6 lg:gap-12 py-10 sm:py-14 border-b border-[var(--color-rule)]">
        <header class="lg:col-span-4 lg:sticky lg:top-24 self-start">
          <p class="label flex items-center gap-2">
            {job.current && <span class="live-dot"></span>}
            {job.period}
          </p>
          <h2 class="display text-4xl sm:text-5xl mt-3">{job.company}</h2>
          {job.ladder ? (
            <ol class="mt-3 space-y-1">
              {job.ladder.map((step, i) => (
                <li class={i === 0 ? 'font-medium' : 'text-[var(--color-muted)]'}>
                  {step.role} <span class="label normal-case tracking-normal">· from {step.from}</span>
                </li>
              ))}
            </ol>
          ) : (
            <p class="mt-3 font-medium">{job.role}</p>
          )}
          <p class="mt-2 text-sm text-[var(--color-muted)]">{job.org && <>{job.org} · </>}{job.type} · {job.location}</p>
          {job.url && (
            <a href={job.url} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm link">
              {new URL(job.url).hostname.replace('www.', '')} ↗
            </a>
          )}
        </header>

        <div class="lg:col-span-8">
          <p class="text-lg leading-relaxed">{job.summary}</p>
          <ul class="mt-5 space-y-2.5 leading-relaxed text-[var(--color-muted)]">
            {job.points.map(point => (
              <li class="pl-4 relative before:content-[''] before:absolute before:left-0 before:top-[0.75em] before:w-1.5 before:h-px before:bg-[var(--color-muted)]">{point}</li>
            ))}
          </ul>
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tools">
            {job.tags.map(tag => (
              <li class="font-mono text-[0.7rem] px-2 py-1 rounded-md bg-[var(--color-wash)] text-[var(--color-muted)]">{tag}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
