---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    company: 'DreamDesk AI',
    role: 'AI Product Engineer & Team Lead',
    type: 'Full-time',
    period: 'Jan 2026 – Present',
    location: 'Remote · UK',
    description: [
      'Led a team of 2 engineers and shipped POC within 4 weeks.',
      'Designed end-to-end product architecture and UX for a hospitality AI platform.',
      'Collaborated directly with the product owner to scope features and drive R&D.',
      'Built multi-channel AI agents across phone calls, emails, web chat, WhatsApp, and Booking.com.',
      'Integrated Mews & Guestline PMS for real-time reservation sync.',
      'Built a RAG pipeline ingesting hotel knowledge bases.',
    ],
    tags: ['FastAPI', 'Next.js', 'GCP', 'Cloud Run', 'Pydantic AI', 'Pinecone', 'PostgreSQL', 'GitHub Actions'],
    url: 'http://dreamdeskai.com/',
    current: true,
  },
  {
    company: 'Simplora AI',
    role: 'Full Stack AI Engineer',
    type: 'Part-time',
    period: 'Jul 2025 – Present',
    location: 'Remote · USA',
    description: [
      'Founding AI Engineer. Shipped MVP in 2 months and scaled to 300+ active users.',
      'Built agentic workflows using LangChain to automate the complete meeting lifecycle.',
      'Integrated MCP servers connecting agents with ClickUp, Slack, Google Drive, and Notion.',
      'Optimized DB queries, reducing response latency from 60s to under 2s.',
    ],
    tags: ['Node.js', 'Next.js', 'LangChain', 'MCP', 'PostgreSQL', 'Digital Ocean', 'GitHub Actions'],
    url: 'https://simplora.ai',
    current: true,
  },
  {
    company: 'Reconsider AI',
    role: 'Full-Stack AI Engineer',
    type: 'Contract',
    period: 'Nov 2025 – Dec 2025',
    location: 'Remote · Estonia',
    description: [
      'Built a Chrome extension to detect deepfake and AI-generated images on e-commerce sites.',
      'Integrated image classification models into a real-time browser-side pipeline.',
      'Improved UX to handle latency, keeping users engaged during processing.',
    ],
    tags: ['FastAPI', 'Python', 'Next.js', 'JavaScript', 'C2PA'],
    url: 'https://www.reconsider.ai/',
    current: false,
  },
  {
    company: 'AI Governance Sandbox',
    role: 'Full-Stack AI Engineer',
    type: 'Full-time',
    period: 'Apr 2025 – Nov 2025',
    location: 'Remote · USA',
    description: [
      'Founding Fullstack AI Engineer on an automated AI compliance evaluation platform.',
      'Built a multi-agentic system covering EU AI Act, US regulations, and global compliance frameworks.',
      'Fixed retrieval accuracy by building an agentic retrieval system with iterative context refinement.',
    ],
    tags: ['Python', 'FastAPI', 'LangGraph', 'Docker', 'MongoDB', 'AWS EC2', 'AWS S3', 'GitHub Actions'],
    url: 'https://aigovsandbox.com/',
    current: false,
  },
  {
    company: 'Foomotion LLC',
    role: 'Full-Stack AI Engineer',
    type: 'Full-time',
    period: 'Dec 2024 – Apr 2025',
    location: 'Lahore · On-site',
    description: [
      'Worked with YC-funded startups, led client syncs, and owned AI development end-to-end.',
      'Built RAG and multi-agentic systems using AWS Bedrock, LangGraph, LangChain, and LlamaIndex.',
      'Developed LiveKit voice agents and n8n automation workflows.',
    ],
    tags: ['FastAPI', 'Next.js', 'LangGraph', 'LangChain', 'LlamaIndex', 'LiveKit', 'n8n', 'PostgreSQL', 'AWS EC2', 'AWS S3', 'AWS Bedrock'],
    url: 'https://www.foomotion.io/',
    current: false,
  },
  {
    company: 'Cyber Evangelists',
    role: 'AI Engineer',
    type: 'Full-time',
    period: 'Jun 2024 – Dec 2024',
    location: 'Lahore · On-site',
    description: [
      'Built a real-time RAG voice agent with TTS, STT, and voice cloning for automated conversations.',
      'Built an Attack Surface Management (ASM) MVP using FastAPI and gRPC microservices.',
      'Dockerized each service independently to follow microservice architecture.',
    ],
    tags: ['Node.js', 'FastAPI', 'gRPC', 'Docker', 'LangChain', 'PostgreSQL', 'Redis'],
    url: null,
    current: false,
  },
];

const typeStyles: Record<string, string> = {
  'Full-time': 'bg-[var(--color-border)] text-[var(--color-muted)]',
  'Part-time': 'bg-[var(--color-border)] text-[var(--color-muted)]',
  'Contract': 'bg-[var(--color-border)] text-[var(--color-muted)]',
};
---

<BaseLayout
  title="Work — Shahzaib"
  description="Work experience and projects by Shahzaib — AI engineer building at the intersection of AI and software."
>
  <div class="pt-8 sm:pt-12 fade-in">
    <h1 class="text-2xl sm:text-3xl mb-2 leading-tight" style="font-family: var(--font-serif)">
      Work
    </h1>
    <p class="text-[var(--color-muted)] mb-6 sm:mb-8">
      Roles and products across AI engineering, founding teams, and product leadership.
    </p>

    <h2 class="text-base font-medium text-[var(--color-ink)] mb-2">Highlights</h2>
    <ul class="list-disc list-inside text-sm text-[var(--color-muted)] leading-relaxed space-y-1.5 mb-8 sm:mb-10">
      <li>3+ years building production AI systems: RAG pipelines, multi-agent workflows, and voice AI agents.</li>
      <li>Founding engineer at multiple AI startups including a Y-Combinator funded company.</li>
      <li>Shipped MVPs, scaled products to 300+ users, and led engineering teams.</li>
    </ul>

    <div class="flex flex-col gap-5 pb-12">
      {experience.map((job, i) => (
        <article
          class={`border border-[var(--color-border)] rounded-xl p-4 sm:p-6 hover:border-[#d0cdc7] transition-colors fade-in fade-in-delay-${Math.min(i + 1, 4)}`}
        >
          <div class="flex items-start justify-between gap-4 mb-1">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-0.5">
                <h2 class="text-base font-medium">{job.role}</h2>
                <span class={`text-xs px-2 py-0.5 rounded-full font-medium flex-shrink-0 ${typeStyles[job.type]}`}>
                  {job.type}
                </span>
                {job.current && (
                  <span class="text-xs px-2 py-0.5 rounded-full font-medium bg-[var(--color-border)] text-[var(--color-muted)] flex-shrink-0">
                    current
                  </span>
                )}
              </div>
              <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm text-[var(--color-muted)]">
                <span class="font-medium text-[var(--color-ink)]">{job.company}</span>
                <span>·</span>
                <span>{job.period}</span>
                <span>·</span>
                <span>{job.location}</span>
              </div>
            </div>
            {job.url && (
              <a
                href={job.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)] transition-colors flex-shrink-0 mt-1"
                aria-label={`Visit ${job.company}`}
              >
                ↗
              </a>
            )}
          </div>

          <ul class="text-[var(--color-muted)] text-sm leading-relaxed mt-3 mb-4 list-disc list-inside space-y-1">
            {job.description.map((point: string) => (
              <li>{point}</li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-2">
            {job.tags.map(tag => (
              <span class="text-xs bg-[var(--color-border)] text-[var(--color-muted)] px-2.5 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
